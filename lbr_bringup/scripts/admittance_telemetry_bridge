#!/usr/bin/env python3
"""Publish the legacy iiwa7 telemetry topics from the active LBR state topic."""

import math
import time

import rclpy
from builtin_interfaces.msg import Time
from diagnostic_msgs.msg import DiagnosticArray, DiagnosticStatus, KeyValue
from lbr_bringup.telemetry_timing import NativeTimeMapper
from lbr_fri_idl.msg import LBRState
from rclpy.node import Node
from rclpy.qos import QoSProfile, qos_profile_sensor_data
from sensor_msgs.msg import JointState


class AdmittanceTelemetryBridge(Node):
    def __init__(self):
        super().__init__("admittance_telemetry_bridge")
        self.declare_parameter("joint_prefix", "iiwa7")
        self._joint_prefix = self.get_parameter("joint_prefix").value
        self._joint_names = [f"{self._joint_prefix}_A{i}" for i in range(1, 8)]
        self._last_position = None
        self._last_native_ns = None
        self._last_segment = None
        self._mapper = NativeTimeMapper()
        self.declare_parameter("max_feedback_age_ms", 100.0)
        max_age_ms = self.get_parameter("max_feedback_age_ms").value
        if not math.isfinite(max_age_ms) or max_age_ms <= 0:
            raise ValueError("max_feedback_age_ms must be positive and finite")
        self._max_age_ns = int(max_age_ms * 1e6)

        qos = QoSProfile(depth=10)
        self._state_pub = self.create_publisher(LBRState, "fri_state", qos)
        self._joint_state_pub = self.create_publisher(JointState, "joint_states", qos)
        self._joint_command_pub = self.create_publisher(JointState, "joint_commands", qos)
        self._timing_pub = self.create_publisher(DiagnosticArray, "telemetry_timing", qos)
        self._state_sub = self.create_subscription(LBRState, "state", self._on_state, qos)
        self._command_sub = self.create_subscription(
            JointState, "admittance_controller/joint_commands", self._on_command,
            qos_profile_sensor_data)

    def _on_command(self, command):
        # Preserve the controller update timestamp and the exact written targets.
        expected = [f"_A{i}" for i in range(1, 8)]
        if (len(command.name) != 7 or
                any(not name.endswith(suffix) for name, suffix in zip(command.name, expected)) or
                len(command.position) != 7 or
                not all(math.isfinite(value) for value in command.position)):
            self.get_logger().warning("Invalid controller command telemetry; skipping",
                                      throttle_duration_sec=5.0)
            return
        command.name = self._joint_names
        self._joint_command_pub.publish(command)

    def _on_state(self, state):
        # Preserve the full FRI state under the legacy topic name.
        self._state_pub.publish(state)

        now_ns = self.get_clock().now().nanoseconds
        steady_ns = time.monotonic_ns()
        if not 0 <= state.time_stamp_nano_sec < 1_000_000_000:
            self.get_logger().warning("Invalid native FRI timestamp; skipping derived telemetry",
                                      throttle_duration_sec=5.0)
            return
        native_ns = state.time_stamp_sec * 1_000_000_000 + state.time_stamp_nano_sec
        sample = self._mapper.map(native_ns, now_ns, steady_ns)
        if sample is None:
            return
        if sample.reset_reason:
            self.get_logger().warning(f"FRI timestamp mapping reset: {sample.reset_reason}")
        if self._last_segment != sample.segment:
            self._last_position = None
            self._last_native_ns = None
            self._last_segment = sample.segment
        if now_ns - sample.stamp_ns > self._max_age_ns:
            self.get_logger().warning("Delayed FRI sample; skipping derived telemetry",
                                      throttle_duration_sec=5.0)
            self._last_position = None
            self._last_native_ns = None
            return
        sec, nanosec = divmod(sample.stamp_ns, 1_000_000_000)
        if not 0 <= sec < 2**31:
            self.get_logger().warning("Mapped timestamp outside ROS Time range")
            return
        stamp = Time(sec=sec, nanosec=nanosec)
        measured = list(state.measured_joint_position)
        if not all(math.isfinite(v) for v in measured + list(state.measured_torque)):
            self.get_logger().warning("Invalid measured FRI state; skipping derived telemetry",
                                      throttle_duration_sec=5.0)
            self._last_position = None
            self._last_native_ns = None
            return
        sample_time = (
            (native_ns - self._last_native_ns) * 1e-9
            if self._last_native_ns is not None and native_ns > self._last_native_ns
            else 0.0
        )

        # An initial sample or a large gap has no usable velocity estimate.
        velocity = []
        if self._last_position is not None and 0.0 < sample_time <= self._max_age_ns * 1e-9:
            velocity = [
                (current - previous) / sample_time
                for current, previous in zip(measured, self._last_position)
            ]
        self._last_position = measured
        self._last_native_ns = native_ns

        measured_msg = JointState()
        measured_msg.header.stamp = stamp
        measured_msg.name = self._joint_names
        measured_msg.position = measured
        measured_msg.velocity = velocity
        measured_msg.effort = list(state.measured_torque)
        self._joint_state_pub.publish(measured_msg)

        # Record an explicit native-to-ROS association for each measured packet.
        timing = DiagnosticArray()
        timing.header.stamp = stamp
        status = DiagnosticStatus()
        status.name = "FRI telemetry timestamp association"
        status.hardware_id = self._joint_prefix
        status.level = DiagnosticStatus.OK
        status.message = "Host-receipt estimate; absolute clock offset is uncalibrated"
        status.values = [KeyValue(key=key, value=str(value)) for key, value in {
            "native_ns": native_ns,
            "mapped_ns": sample.stamp_ns,
            "host_callback_ns": now_ns,
            "offset_ns": self._mapper.offset_ns,
            "clock_segment": sample.segment,
            "estimated_age_ns": now_ns - sample.stamp_ns,
            "mapping_reset": sample.reset_reason,
        }.items()]
        timing.status = [status]
        self._timing_pub.publish(timing)


def main(args=None):
    rclpy.init(args=args)
    node = AdmittanceTelemetryBridge()
    try:
        rclpy.spin(node)
    finally:
        node.destroy_node()
        rclpy.shutdown()


if __name__ == "__main__":
    main()
